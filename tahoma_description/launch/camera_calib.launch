<launch>
  <!-- RealSense -->
  <!-- <include file="$(find tahoma_bringup)/launch/camera.launch">
    <arg name="camera" value="camera"/>
  </include> -->

  <!-- AprilTag detection -->
  <include file="$(find apriltag_ros)/launch/continuous_detection.launch">
    <arg name="camera_name"  value="/camera/color"/>
    <arg name="image_topic"  value="image_raw"/>
  </include>

  <!-- easy_handeye: eye-on-base (fixed camera, tag on end-effector) -->
  <include file="$(find easy_handeye)/launch/calibrate.launch">
    <arg name="eye_on_hand"                value="false"/>
    <arg name="robot_base_frame"           value="arm_base_link"/>
    <arg name="robot_effector_frame"       value="arm_wrist_2_link"/>
    <arg name="tracking_base_frame"        value="camera_color_genesis"/>
    <arg name="tracking_marker_frame"      value="tag_1"/>
    <arg name="move_group"                 value="manipulator"/>
  </include>
</launch>