<launch>
  <!-- Camera 1 -->
  <arg name="camera1"     default="camera1"/>
  <arg name="tf_prefix1"  default="$(arg camera1)"/>
  <arg name="serial_no1"  default="215222077034"/>

  <!-- Camera 2 -->
  <arg name="camera2"     default="camera2"/>
  <arg name="tf_prefix2"  default="$(arg camera2)"/>
  <arg name="serial_no2"  default="909512071469"/>

  <!-- Fusion -->
  <arg name="output_frame"    default="base_link"/>
  <arg name="fused_tf_prefix" default="fused"/>

  <!-- Both cameras negotiate USB 2.1, not USB 3.0 (reduced performance is 213622252863
       expected per the realsense driver's own warning), so two full-rate
       color streams overrun the bus and load the machine. Calibration is
       static (hold still, press Enter), so a low fps is plenty; disabling
       enable_confidence removes a stream that's on by default in
       rs_camera.launch even though depth is off and unused here. -->
  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera"            value="$(arg camera2)"/>
    <arg name="tf_prefix"         value="$(arg tf_prefix2)"/>
    <arg name="serial_no"         value="$(arg serial_no2)"/>
    <arg name="enable_depth"      value="false"/>
    <arg name="enable_confidence" value="false"/>
    <arg name="enable_pointcloud" value="false"/>
    <arg name="align_depth"       value="false"/>
    <arg name="color_fps"         value="6"/>
    <arg name="color_width"       value="1280"/>
    <arg name="color_height"      value="1080"/>
    <arg name="publish_tf"        value="true"/>
  </include>
  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera"            value="$(arg camera1)"/>
    <arg name="tf_prefix"         value="$(arg tf_prefix1)"/>
    <arg name="serial_no"         value="$(arg serial_no1)"/>
    <arg name="enable_depth"      value="false"/>
    <arg name="enable_confidence" value="false"/>
    <arg name="enable_pointcloud" value="false"/>
    <arg name="align_depth"       value="false"/>
    <arg name="color_fps"         value="6"/>
    <arg name="color_width"       value="1280"/>
    <arg name="color_height"      value="720"/>
    <arg name="publish_tf"        value="true"/>
  </include>


<!-- Resolution	Supported FPS
1920×1080	30, 15, 6
1280×720	30, 15, 6
960×540	60, 30, 15, 6
848×480	60, 30, 15, 6
640×480	60, 30, 15, 6
640×360	60, 30, 15, 6
424×240	60, 30, 15, 6
320×240	60, 30, 6
320×180	60, 30, 6 -->
</launch>
