#!/usr/bin/env python3
import rospy
import tf2_ros
from geometry_msgs.msg import Pose, PoseStamped
import tf.transformations as tf
import numpy as np
from scipy.linalg import expm

rospy.init_node("test_tf_lookup")

tf_buffer = tf2_ros.Buffer()
listener = tf2_ros.TransformListener(tf_buffer)

rospy.sleep(0.5)

def transform_to_mat(T):
    pos = T.transform.translation
    rot = T.transform.rotation
    return tf.concatenate_matrices(
        tf.translation_matrix([pos.x, pos.y, pos.z]),
        tf.quaternion_matrix([rot.x, rot.y, rot.z, rot.w,
                                ])
    )
def mat_to_pose(T):
    p = Pose()
    p.position.x, p.position.y, p.position.z = tf.translation_from_matrix(T)
    q = tf.quaternion_from_matrix(T)
    p.orientation.x, p.orientation.y, p.orientation.z, p.orientation.w = q
    return p
def pose_to_mat(p):
    pos = p.pose.position
    rot = p.pose.orientation
    return tf.concatenate_matrices(
        tf.translation_matrix([pos.x, pos.y, pos.z]),
        tf.quaternion_matrix([rot.x, rot.y, rot.z, rot.w,])
    )




def log_transform(msg):
    T_ee_tip = tf_buffer.lookup_transform(
        "arm_tool0",
        "gripper_equilibrium_grasp",
        rospy.Time(0),
        rospy.Duration(1.0)
    )

    T_base_tip = tf_buffer.lookup_transform(
        "base_link",
        "gripper_equilibrium_grasp",
        rospy.Time(0),
        rospy.Duration(1.0)
    )

    T_base_ee = tf_buffer.lookup_transform(
        "base_link",
        "arm_tool0",
        rospy.Time(0),
        rospy.Duration(1.0)
    )
    mat_base_tip = transform_to_mat(T_base_tip)
    mat_ee_tip = transform_to_mat(T_ee_tip)
    mat_tip_delta = pose_to_mat(msg)

    mat_base_new_tool0 = mat_base_tip @ mat_tip_delta @ np.linalg.inv(mat_ee_tip)
    new_ee_pose = mat_to_pose(mat_base_new_tool0)

    rospy.loginfo(f"Current EE Pose\n{T_base_ee.transform}")
    rospy.loginfo(f"New EE Pose\n{new_ee_pose}")

sub = rospy.Subscriber("/haptic_search/proposed_pose", PoseStamped, log_transform)
rospy.spin()